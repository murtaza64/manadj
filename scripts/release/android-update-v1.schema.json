        "candidate_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Sha256",
          "type": "string"
        },
        "content_entries_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Entries Sha256",
          "type": "string"
        },
        "expected_signer_cert_sha256": {
          "const": "18f8fe820d6abd112be1fa5c99e3c69f77cbb5c834242899135c9b528af7417c",
