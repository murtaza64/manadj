            },
            {
              "type": "null"
            }
          ],
          "title": "Artifact Sha256"
        },
        "build_batch_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Build Batch Id",
          "type": "string"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Receipt Sha256",
          "type": "string"
        },
        "release_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Release Id",
          "type": "string"
        },
        "result": {
          "const": "pass",
          "title": "Result",
          "type": "string"
        },
        "scope": {
          "enum": [
            "source",
            "unsigned",
            "signed"
          ],
          "title": "Scope",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        },
        "source_tree_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Tree Sha256",
          "type": "string"
        }
