    "Notes": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "title": "Body",
          "type": "string"
        },
        "release_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Release Id",
          "type": "string"
        },
        "schema": {
          "const": 1,
          "title": "Schema",
          "type": "integer"
        }
      },
      "required": [
        "schema",
        "release_id",
        "body"
      ],
      "title": "Notes",
      "type": "object"
    },
    "QAReceipt": {
      "additionalProperties": false,
      "properties": {
        "artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
