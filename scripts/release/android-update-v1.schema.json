      "title": "BuildInfo",
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "build": {
          "$ref": "#/$defs/AndroidBuild"
        },
        "build_info": {
          "$ref": "#/$defs/BuildInfo"
        },
        "channel": {
          "enum": [
            "stable",
            "preview"
          ],
          "title": "Channel",
          "type": "string"
        },
        "content_entries_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Entries Sha256",
          "type": "string"
        },
        "format": {
          "const": "manadj_android_candidate/v1",
          "title": "Format",
          "type": "string"
        },
        "qa_receipts": {
          "items": {
            "$ref": "#/$defs/QAReceipt"
          },
          "maxItems": 64,
          "minItems": 2,
          "title": "Qa Receipts",
          "type": "array"
        },
        "release_notes": {
          "$ref": "#/$defs/Notes"
        },
        "unsigned_apk_bytes": {
          "maximum": 536870912,
          "minimum": 1,
          "title": "Unsigned Apk Bytes",
          "type": "integer"
        },
        "unsigned_apk_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Unsigned Apk Sha256",
          "type": "string"
        },
        "verification_receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Verification Receipt Sha256",
          "type": "string"
        }
      },
      "required": [
        "format",
        "channel",
        "build",
        "build_info",
        "release_notes",
        "unsigned_apk_sha256",
        "unsigned_apk_bytes",
        "content_entries_sha256",
        "verification_receipt_sha256",
        "qa_receipts"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "Channel": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "stable",
            "preview"
          ],
          "title": "Channel",
          "type": "string"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/Entry"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Entries",
          "type": "array"
        },
        "format": {
          "const": "manadj_android_channel/v1",
          "title": "Format",
          "type": "string"
        },
        "package": {
          "const": "dev.murt.manadj.excalibur",
          "title": "Package",
          "type": "string"
        },
        "signer_cert_sha256": {
          "const": "18f8fe820d6abd112be1fa5c99e3c69f77cbb5c834242899135c9b528af7417c",
          "title": "Signer Cert Sha256",
          "type": "string"
        }
      },
      "required": [
        "format",
        "channel",
        "package",
        "signer_cert_sha256",
        "entries"
      ],
      "title": "Channel",
      "type": "object"
