        "unsigned_apk_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Unsigned Apk Sha256",
          "type": "string"
        }
      },
      "required": [
        "format",
        "candidate_sha256",
        "build",
        "unsigned_apk_sha256",
        "unsigned_apk_bytes",
        "content_entries_sha256",
        "expected_signer_cert_sha256"
