{
  "$defs": {
    "AndroidBuild": {
      "additionalProperties": false,
      "properties": {
        "abis": {
          "items": {
            "enum": [
              "arm64-v8a",
              "armeabi-v7a",
              "x86_64",
              "x86"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Abis",
          "type": "array"
        },
        "build_batch_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Build Batch Id",
          "type": "string"
        },
        "format": {
          "const": "manadj_android_build/v1",
          "title": "Format",
          "type": "string"
        },
        "min_sdk": {
          "maximum": 100,
          "minimum": 26,
          "title": "Min Sdk",
          "type": "integer"
        },
        "notes_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Notes Sha256",
          "type": "string"
        },
        "package": {
          "const": "dev.murt.manadj.excalibur",
          "title": "Package",
          "type": "string"
        },
        "release_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Release Id",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        },
        "source_tree_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Tree Sha256",
          "type": "string"
        },
        "target_sdk": {
          "maximum": 100,
          "minimum": 26,
          "title": "Target Sdk",
          "type": "integer"
        },
        "version_code": {
          "maximum": 2100000000,
          "minimum": 1,
          "title": "Version Code",
          "type": "integer"
        },
        "version_name": {
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.]+)?$",
          "title": "Version Name",
          "type": "string"
        }
      },
      "required": [
        "format",
        "release_id",
        "package",
        "version_code",
        "version_name",
        "source_revision",
        "source_tree_sha256",
        "build_batch_id",
        "notes_sha256",
        "min_sdk",
        "target_sdk",
        "abis"
      ],
      "title": "AndroidBuild",
      "type": "object"
    },
    "BuildInfo": {
      "additionalProperties": false,
      "properties": {
        "notes_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Notes Sha256",
          "type": "string"
        },
        "release_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Release Id",
          "type": "string"
        },
        "schema": {
          "const": 1,
          "title": "Schema",
          "type": "integer"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.]+)?$",
          "title": "Version",
          "type": "string"
