        "scope",
        "result",
        "source_revision",
        "source_tree_sha256",
        "build_batch_id",
        "release_id",
        "artifact_sha256",
        "receipt_sha256"
      ],
      "title": "QAReceipt",
      "type": "object"
    },
    "SignReceipt": {
      "additionalProperties": false,
      "properties": {
        "apk_bytes": {
          "maximum": 536870912,
          "minimum": 1,
          "title": "Apk Bytes",
          "type": "integer"
        },
        "apk_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Apk Sha256",
          "type": "string"
        },
        "build": {
          "$ref": "#/$defs/AndroidBuild"
        },
        "candidate_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Sha256",
          "type": "string"
