        "apk_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Apk Sha256",
          "type": "string"
        },
        "apk_url": {
          "title": "Apk Url",
          "type": "string"
        },
        "build_batch_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Build Batch Id",
          "type": "string"
        },
        "min_sdk": {
          "maximum": 100,
          "minimum": 26,
          "title": "Min Sdk",
          "type": "integer"
        },
        "notes_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Notes Sha256",
          "type": "string"
        },
        "qa_receipt_sha256s": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 2,
          "title": "Qa Receipt Sha256S",
          "type": "array"
        },
        "release_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Release Id",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        },
        "source_tree_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Tree Sha256",
          "type": "string"
        },
        "version_code": {
          "maximum": 2100000000,
          "minimum": 1,
          "title": "Version Code",
          "type": "integer"
        },
        "version_name": {
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.]+)?$",
          "title": "Version Name",
          "type": "string"
        }
      },
      "required": [
        "release_id",
        "version_code",
        "version_name",
        "min_sdk",
        "abis",
        "source_revision",
        "source_tree_sha256",
        "build_batch_id",
        "notes_sha256",
        "apk_url",
        "apk_sha256",
        "apk_bytes",
        "qa_receipt_sha256s"
      ],
      "title": "Entry",
      "type": "object"
