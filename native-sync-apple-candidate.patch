+import XCTest
+import CEngine
+import ManadjCore
+@testable import ManadjAudio
+
+final class SessionCapturePipelineTests: XCTestCase {
+    func testGeneratedEngineQueueConversionRuntimeAndJournalRestart() async throws {
+        let engine = try XCTUnwrap(mdj_create(48000)); defer { mdj_destroy(engine) }
+        let root = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        defer { try? FileManager.default.removeItem(at: root) }
+        let file = root.appendingPathComponent("manifest.json")
+        let journal = try SessionEventJournal(file: file)
+        let runtime = SessionCaptureRuntime(journal: journal, libraryIdentity: "generated-pipeline")
+        var output = [Float](repeating: 0, count: 960)
+        func render() { output.withUnsafeMutableBufferPointer { mdj_render(engine, $0.baseAddress!, 480, 2) } }
+        _ = mdj_prepare(engine, 0, 7); render()
+        XCTAssertTrue(mdj_track_begin(engine, 0, 7, 96000, 48000))
+        let pcm = (0..<192000).map { Float(sin(Double($0 / 2) * 440 * 2 * .pi / 48000) * 0.2) }
+        pcm.withUnsafeBufferPointer { XCTAssertEqual(mdj_track_write(engine, 0, 7, $0.baseAddress!, 96000), 96000) }
+        XCTAssertTrue(mdj_track_finish(engine, 0, 7))
+        mdj_capture_enable(engine, true)
+        _ = mdj_submit(engine, MDJPlay, 0, 0, 0)
+        let start = Date()
+        var maximum: Float = 0
+        var original: [Float] = []
+        for index in 0..<100 {
+            if index == 50 { _ = mdj_submit(engine, MDJFader, 0, 0.6, 0) }
+            render()
+            maximum = max(maximum, output.map(abs).max() ?? 0)
+            original += output
+            var snapshot = MDJCaptureSnapshot()
+            XCTAssertEqual(mdj_capture_pop(engine, &snapshot), 1)
+            let segment = try SessionCaptureAdapter.convert(snapshot) { deck, load in deck == 0 && load == 7 ? 42 : nil }
+            try await runtime.observe(segment, wallTime: start.addingTimeInterval(Double(index) / 100))
+            XCTAssertEqual(mdj_capture_pop(engine, &snapshot), 0)
+        }
+        XCTAssertGreaterThan(maximum, 0.01)
+        try await runtime.stop(at: start.addingTimeInterval(1), incomplete: false)
+        let reopened = try SessionEventJournal(file: file), saved = await reopened.all()
+        XCTAssertEqual(saved.count, 1); XCTAssertFalse(saved[0].incomplete)
+        XCTAssertEqual(saved[0].libraryIdentity, "generated-pipeline")
+        let events = try saved[0].chunks.flatMap { try JSONSerialization.jsonObject(with: $0.events) as! [[String: Any]] }
+        let load = try XCTUnwrap(events.first { $0["kind"] as? String == "load" && $0["channel"] as? String == "A" })
+        XCTAssertEqual(load["trackId"] as? Int, 42)
+        let play = try XCTUnwrap(events.first { $0["action"] as? String == "play" })
+        XCTAssertEqual(play["t"] as? Double, 0)
+        let fader = try XCTUnwrap(events.first { $0["control"] as? String == "fader" && ($0["value"] as? Double ?? 1) < 0.7 })
+        XCTAssertEqual(fader["t"] as? Double, 0.5)
+        // Narrow replay proof for this generated plain play/fader fixture only.
+        // It is not an implementation of the full capture event grammar.
+        let replay = try XCTUnwrap(mdj_create(48000)); defer { mdj_destroy(replay) }
+        _ = mdj_prepare(replay, 0, 7)
+        output.withUnsafeMutableBufferPointer { mdj_render(replay, $0.baseAddress!, 480, 2) }
+        XCTAssertTrue(mdj_track_begin(replay, 0, 7, 96000, 48000))
+        pcm.withUnsafeBufferPointer { XCTAssertEqual(mdj_track_write(replay, 0, 7, $0.baseAddress!, 96000), 96000) }
+        XCTAssertTrue(mdj_track_finish(replay, 0, 7))
+        var reproduced: [Float] = []
+        let playTime = (play["t"] as! NSNumber).doubleValue
+        let faderTime = (fader["t"] as! NSNumber).doubleValue
+        for index in 0..<100 {
+            if index == Int((playTime * 100).rounded()) { _ = mdj_submit(replay, MDJPlay, 0, 0, 0) }
+            if index == Int((faderTime * 100).rounded()) {
+                _ = mdj_submit(replay, MDJFader, 0, (fader["value"] as! NSNumber).doubleValue, 0)
+            }
+            output.withUnsafeMutableBufferPointer { mdj_render(replay, $0.baseAddress!, 480, 2) }
+            reproduced += output
+        }
+        XCTAssertEqual(original.count, reproduced.count)
+        let error = zip(original, reproduced).map { abs($0 - $1) }.max() ?? 1
+        XCTAssertLessThan(error, 0.000001)
+        let times = events.map { ($0["t"] as! NSNumber).doubleValue }
+        XCTAssertEqual(times, times.sorted())
+    }
+}
diff --git a/ios/Packages/ManadjCore/Sources/ManadjCore/AppliedSessionRecorder.swift b/ios/Packages/ManadjCore/Sources/ManadjCore/AppliedSessionRecorder.swift
new file mode 100644
index 00000000..e9aa2a3c
--- /dev/null
+++ b/ios/Packages/ManadjCore/Sources/ManadjCore/AppliedSessionRecorder.swift
@@ -0,0 +1,170 @@
+import Foundation
+
+/// Input must be an applied engine segment, never UI state or command receipt.
+/// Track identity must be resolved for the exact engine load token by the host.
+public struct AppliedSessionDeck: Equatable, Sendable {
+    public var load: UInt64 = 0
+    public var trackID: Int?
+    public var position = 0.0
+    public var startPosition = 0.0
+    public var bpm: Double?
+    public var playing = false
+    public var preview = false
+    public var scratching = false
+    public var ready = false
+    public var launchFrame: UInt64 = 0
+    public var fader = 1.0
+    public var trim = 0.5
+    public var pitch = 0.0
+    public var bend = 0.0
+    public var filter = 0.0
+    public var eq = [0.5, 0.5, 0.5]
+    public var stems = [1.0, 1.0, 1.0, 1.0]
+    public var pfl = false
+    public var loopStart: Double?
+    public var loopEnd: Double?
+    public init() {}
+}
+
+public struct AppliedSessionSegment: Equatable, Sendable {
+    public var startFrame: UInt64
+    public var endFrame: UInt64
+    public var sampleRate: Int
+    public var crossfade: Double
+    public var fxActive = false
+    public var decks: [AppliedSessionDeck]
+    public init(startFrame: UInt64, endFrame: UInt64, sampleRate: Int, crossfade: Double, decks: [AppliedSessionDeck]) {
+        self.startFrame = startFrame; self.endFrame = endFrame; self.sampleRate = sampleRate
+        self.crossfade = crossfade; self.decks = decks
+    }
+}
+
+public enum AppliedRecorderError: Error, Equatable {
+    case invalidSegment, discontinuity, unresolvedTrack, contextFull, stopped
+}
+
+public enum SessionRecorderAction: Equatable, Sendable {
+    case open(UUID, Date, Data)
+    case append(UUID, Int, Data)
+    case close(UUID, Date, incomplete: Bool)
+}
+
+/// Pure event/lifecycle mapper. The caller must persist returned actions in order
+/// before processing the next segment. On a persistence failure discard this
+/// mapper and reconcile the durable journal, never continue from advanced memory.
+/// FX/scratch/preview need a richer adapter and are rejected rather than omitted.
+public struct AppliedSessionRecorder: Sendable {
+    public private(set) var session: UUID?
+    private var previous: AppliedSessionSegment?
+    private var context: [Data] = []
+    private var contextBytes = 0
+    private var contextEvents = 0
+    private var baseFrame: UInt64?
+    private var wallBase: Date?
+    private var lastAudible: UInt64?
+    private var nextSequence = 1
+    private var stopped = false
+    private var tickFrame: UInt64?
+    public init() {}
+
+    public mutating func observe(_ segment: AppliedSessionSegment, wallTime: Date) throws -> [SessionRecorderAction] {
+        guard !stopped else { throw AppliedRecorderError.stopped }
+        stopped = true // Any invalid/unsupported segment fails closed until reconciliation.
+        guard segment.sampleRate > 0, segment.startFrame < segment.endFrame, segment.decks.count == 4, !segment.fxActive,
+              wallTime.timeIntervalSince1970.isFinite, segment.crossfade.isFinite, (-1...1).contains(segment.crossfade) else { throw AppliedRecorderError.invalidSegment }
+        if let previous {
+            guard segment.startFrame == previous.endFrame, segment.sampleRate == previous.sampleRate else {
+                stopped = true; throw AppliedRecorderError.discontinuity
+            }
+        }
+        for deck in segment.decks {
+            guard [deck.position, deck.startPosition, deck.fader, deck.trim, deck.pitch, deck.bend, deck.filter].allSatisfy(\.isFinite),
+                  deck.eq.count == 3, deck.stems.count == 4, deck.eq.allSatisfy(\.isFinite), deck.stems.allSatisfy(\.isFinite),
+                  deck.bpm.map({ $0.isFinite }) ?? true,
+                  !deck.preview, !deck.scratching else { throw AppliedRecorderError.invalidSegment }
+            if deck.load != 0 && deck.trackID == nil { throw AppliedRecorderError.unresolvedTrack }
+        }
+        if baseFrame == nil { baseFrame = segment.startFrame; wallBase = wallTime }
+        let t = Double(segment.startFrame - baseFrame!) / Double(segment.sampleRate)
+        let endT = Double(segment.endFrame - baseFrame!) / Double(segment.sampleRate)
+        var events: [[String: Any]] = []
+        func emit(_ event: [String: Any]) { events.append(event) }
+        if previous == nil || previous!.crossfade != segment.crossfade {
+            emit(["t": t, "kind": "control", "channel": NSNull(), "control": "crossfader", "value": segment.crossfade])
+            if previous == nil { emit(["t": t, "kind": "control", "channel": NSNull(), "control": "crossfaderEnabled", "value": 1]) }
+        }
+        for index in 0..<4 {
+            let channel = ["A", "B", "C", "D"][index], deck = segment.decks[index]
+            let old = previous?.decks[index]
+            if old == nil {
+                emit(["t": t, "kind": "control", "channel": channel, "control": "crossfaderAssignment", "value": index % 2 == 0 ? -1 : 1])
+            }
+            var controls: [(String, Double, Double?)] = [
+                ("fader", deck.fader, old?.fader), ("trim", deck.trim, old?.trim),
+                ("filter", deck.filter, old?.filter), ("pfl", deck.pfl ? 1 : 0, old.map { $0.pfl ? 1 : 0 })]
+            for k in 0..<3 { controls.append((["eqLow", "eqMid", "eqHigh"][k], deck.eq[k], old?.eq[k])) }
+            for k in 0..<4 { controls.append((["stemVocals", "stemDrums", "stemBass", "stemOther"][k], deck.stems[k], old?.stems[k])) }
+            for (name, value, oldValue) in controls where oldValue != value {
+                emit(["t": t, "kind": "control", "channel": channel, "control": name, "value": value])
+            }
+            let changedLoad = old == nil || old!.load != deck.load || old!.trackID != deck.trackID
+            if changedLoad {
+                emit(["t": t, "kind": "load", "channel": channel, "trackId": deck.trackID as Any? ?? NSNull(), "bpm": deck.bpm as Any? ?? NSNull()])
+            }
+            if changedLoad || old!.pitch != deck.pitch { emit(["t": t, "kind": "pitch", "channel": channel, "value": deck.pitch]) }
+            if changedLoad || old!.bend != deck.bend { emit(["t": t, "kind": "bend", "channel": channel, "value": deck.bend]) }
+            if changedLoad || old!.loopStart != deck.loopStart || old!.loopEnd != deck.loopEnd {
+                let region: Any = (deck.loopStart != nil && deck.loopEnd != nil) ? ["start": deck.loopStart!, "end": deck.loopEnd!] : NSNull()
+                emit(["t": t, "kind": "loop", "channel": channel, "playhead": deck.startPosition, "region": region])
+            }
+            let playing = deck.playing && deck.launchFrame == 0
+            let wasPlaying = old.map { $0.playing && $0.launchFrame == 0 } ?? false
+            if changedLoad || playing != wasPlaying {
+                emit(["t": t, "kind": "transport", "channel": channel, "action": playing ? "play" : "pause", "playhead": deck.startPosition])
+            } else if let old, abs(deck.startPosition - old.position) > 0.0001 {
+                emit(["t": t, "kind": "transport", "channel": channel, "action": "seek", "playhead": deck.startPosition])
+            }
+        }
+        // Position evidence at segment end is distinct from applied control time.
+        if tickFrame == nil || segment.endFrame - tickFrame! >= UInt64(segment.sampleRate) {
+            emit(["t": endT, "kind": "tick", "playheads": Dictionary(uniqueKeysWithValues: (0..<4).map { (["A", "B", "C", "D"][$0], segment.decks[$0].position) })])
+            tickFrame = segment.endFrame
+        }
+        let data = try JSONSerialization.data(withJSONObject: events, options: [.sortedKeys])
+        let audible = segment.decks.enumerated().contains { index, deck in
+            let xf = index % 2 == 0 ? min(1, 1 - segment.crossfade) : min(1, 1 + segment.crossfade)
+            return deck.trackID != nil && deck.ready && deck.playing && deck.launchFrame == 0 && deck.fader > 0 && deck.trim > 0 && deck.eq.contains(where: { $0 > 0 }) && deck.stems.contains(where: { $0 > 0 }) && xf > 0
+        }
+        if audible { lastAudible = segment.endFrame }
+        var actions: [SessionRecorderAction] = []
+        if let session {
+            if !events.isEmpty { actions.append(.append(session, nextSequence, data)); nextSequence += 1 }
+            if let lastAudible, segment.endFrame - lastAudible >= UInt64(segment.sampleRate) * 600 {
+                actions.append(.close(session, wallBase!.addingTimeInterval(endT), incomplete: false))
+                self.session = nil; context = []; contextBytes = 0; contextEvents = 0
+                baseFrame = nil; wallBase = nil; self.lastAudible = nil
+                previous = nil; tickFrame = nil; stopped = false
+                return actions // Next segment must seed a fresh complete context.
+            }
+        } else {
+            if !events.isEmpty { context.append(data); contextBytes += data.count; contextEvents += events.count }
+            guard contextBytes <= 160 * 1024, contextEvents <= 1024 else { stopped = true; throw AppliedRecorderError.contextFull }
+            if audible {
+                let id = UUID(); session = id; nextSequence = 1
+                let objects = try context.flatMap { try JSONSerialization.jsonObject(with: $0) as! [[String: Any]] }
+                actions.append(.open(id, wallBase!, try JSONSerialization.data(withJSONObject: objects, options: [.sortedKeys])))
+                context = []; contextBytes = 0; contextEvents = 0
+            }
+        }
+        previous = segment
+        stopped = false
+        return actions
+    }
+
+    public mutating func stop(at date: Date, incomplete: Bool) -> [SessionRecorderAction] {
+        stopped = true
+        guard let session else { return [] }
+        self.session = nil
+        return [.close(session, date, incomplete: incomplete)]
+    }
+}
diff --git a/ios/Packages/ManadjCore/Sources/ManadjCore/SessionCaptureRuntime.swift b/ios/Packages/ManadjCore/Sources/ManadjCore/SessionCaptureRuntime.swift
new file mode 100644
index 00000000..63037ce0
--- /dev/null
+++ b/ios/Packages/ManadjCore/Sources/ManadjCore/SessionCaptureRuntime.swift
@@ -0,0 +1,75 @@
+import Foundation
+
+/// Disabled host integration building block. One caller supplies ordered applied
+/// segments, exact identities and explicit interruption/gap signals. No timers,
+/// engine enabling, network, or lifecycle assumptions are hidden here.
+public actor SessionCaptureRuntime {
+    private let journal: SessionEventJournal
+    private let libraryIdentity: String
+    private var mapper = AppliedSessionRecorder()
+    private var sequence = 1
+    private var pending: [[String: Any]] = []
+    private var pendingBytes = 0
+    private var pendingSession: UUID?
+    private var lastFlushFrame: UInt64?
+    private var failed = false
+    private var busy = false
+
+    public init(journal: SessionEventJournal, libraryIdentity: String) {
+        self.journal = journal; self.libraryIdentity = libraryIdentity
+    }
+
+    /// Pending events are not acknowledged durable until flush. At most one
+    /// rendered second is batched; explicit stop flushes before terminal close.
+    public func observe(_ segment: AppliedSessionSegment, wallTime: Date) async throws {
+        guard !failed, !busy else { throw AppliedRecorderError.stopped }
+        busy = true
+        defer { busy = false }
+        do {
+            let actions = try mapper.observe(segment, wallTime: wallTime)
+            for action in actions {
+                switch action {
+                case .open(let id, let start, let context):
+                    try await flush()
+                    try await journal.open(uuid: id, libraryIdentity: libraryIdentity, startedAt: start, context: context)
+                    sequence = 1; pendingSession = id; lastFlushFrame = segment.endFrame
+                case .append(let id, _, let bytes):
+                    let events = try JSONSerialization.jsonObject(with: bytes) as! [[String: Any]]
+                    if pending.count + events.count > 1024 || pendingBytes + bytes.count > 128 * 1024 { try await flush() }
+                    guard pendingSession == id else { throw SessionJournalError.invalidState }
+                    pending += events; pendingBytes += bytes.count
+                case .close(let id, let date, let incomplete):
+                    try await flush()
+                    try await journal.close(uuid: id, endedAt: date, incomplete: incomplete)
+                    pendingSession = nil
+                }
+            }
+            if let previous = lastFlushFrame, segment.endFrame - previous >= UInt64(segment.sampleRate) {
+                try await flush(); lastFlushFrame = segment.endFrame
+            }
+        } catch {
+            failed = true
+            // Never convert unpersisted or unsupported history to a complete close.
+            if let id = pendingSession { try? await journal.close(uuid: id, endedAt: wallTime, incomplete: true) }
+            throw error
+        }
+    }
+
+    public func stop(at date: Date, incomplete: Bool) async throws {
+        guard !failed, !busy else { throw AppliedRecorderError.stopped }
+        busy = true
+        defer { busy = false }
+        failed = true
+        try await flush()
+        for action in mapper.stop(at: date, incomplete: incomplete) {
+            if case .close(let id, let end, let gap) = action { try await journal.close(uuid: id, endedAt: end, incomplete: gap) }
+        }
+    }
+
+    private func flush() async throws {
+        guard !pending.isEmpty, let id = pendingSession else { return }
+        let data = try JSONSerialization.data(withJSONObject: pending, options: [.sortedKeys])
+        try await journal.append(uuid: id, expectedSequence: sequence, events: data)
+        sequence += 1; pending = []; pendingBytes = 0
+    }
+}
diff --git a/ios/Packages/ManadjCore/Sources/ManadjCore/SessionEventJournal.swift b/ios/Packages/ManadjCore/Sources/ManadjCore/SessionEventJournal.swift
new file mode 100644
index 00000000..04fe4468
--- /dev/null
+++ b/ios/Packages/ManadjCore/Sources/ManadjCore/SessionEventJournal.swift
@@ -0,0 +1,341 @@
+import Foundation
+import CoreFoundation
+#if canImport(Darwin)
+import Darwin
+#else
+import Glibc
+#endif
+
+public enum SessionJournalError: Error, Equatable {
+    case invalidState, invalidEvents, full, sessionClosed, sequenceMismatch, persistence
+}
+
+public struct SessionEventChunk: Codable, Equatable, Sendable {
+    public let sequence: Int
+    /// Existing capture-events JSON, local IDs still scoped to this journal's library.
+    public let events: Data
+}
+
+public struct JournalSession: Codable, Equatable, Sendable {
+    public let uuid: UUID
+    public let libraryIdentity: String
+    public let startedAt: Date
+    public var endedAt: Date?
+    public var incomplete: Bool
+    public var acknowledgedThrough: Int
+    public var chunks: [SessionEventChunk]
+}
+
+/// Local-only session evidence. One actor owns the manifest and its chunk tree.
+/// Chunks are flushed before the committed-prefix manifest. Unreferenced orphans
+/// are retained, not guessed away. Acknowledgement does not delete evidence.
+/// This test-bounded store still has no qualified long-session retention policy.
+public actor SessionEventJournal {
+    public static let maximumBytes = 8 * 1024 * 1024
+    private struct StoredSession: Codable {
+        let uuid: UUID
+        let libraryIdentity: String
+        let startedAt: Date
+        let endedAt: Date?
+        let incomplete: Bool
+        let acknowledgedThrough: Int
+        let chunkCount: Int
+    }
+    private struct Envelope: Codable { let version: Int; let sessions: [StoredSession] }
+    private let file: URL
+    private var sessions: [JournalSession]
+    private var quarantined: [StoredSession] = []
+    private var storageBlocked = false
+    public private(set) var damagedSessionIDs: [UUID] = []
+    public private(set) var storageBytes = 0
+    public private(set) var storageFiles = 0
+    public static let maximumDiskBytes = 64 * 1024 * 1024
+    public static let maximumFiles = 8192
+    private var uncertainWrite = false
+    private var eventByteCount = 0
+    private let writer: @Sendable (Data, URL) throws -> Void
+
+    public init(file: URL, writer: @escaping @Sendable (Data, URL) throws -> Void = SessionEventJournal.durableWrite) throws {
+        guard file.isFileURL else { throw SessionJournalError.invalidState }
+        self.file = file; self.writer = writer
+        let usage = try Self.diskUsage(file)
+        storageBytes = usage.bytes; storageFiles = usage.files
+        storageBlocked = usage.bytes >= Self.maximumDiskBytes || usage.files >= Self.maximumFiles
+        if FileManager.default.fileExists(atPath: file.path) {
+            let data = try Data(contentsOf: file)
+            guard data.count <= Self.maximumBytes else { throw SessionJournalError.full }
+            let stored = try JSONDecoder().decode(Envelope.self, from: data)
+            guard stored.version == 2, stored.sessions.count <= 512 else { throw SessionJournalError.invalidState }
+            var saved: [JournalSession] = []
+            for entry in stored.sessions {
+                do {
+                guard entry.chunkCount > 0, entry.chunkCount <= Self.maximumBytes / 16 else { throw SessionJournalError.invalidState }
+                var chunks: [SessionEventChunk] = []
+                for sequence in 0..<entry.chunkCount {
+                    let chunkFile = Self.chunkURL(file, entry.uuid, sequence)
+                    let properties = try chunkFile.resourceValues(forKeys: [.fileSizeKey, .isSymbolicLinkKey])
+                    guard properties.isSymbolicLink != true else { throw SessionJournalError.invalidState }
+                    let size = properties.fileSize ?? Self.maximumBytes
+                    guard size <= 160 * 1024 else { throw SessionJournalError.full }
+                    let bytes = try Data(contentsOf: chunkFile, options: [.mappedIfSafe])
+                    guard bytes.count <= 160 * 1024 else { throw SessionJournalError.full }
+                    chunks.append(.init(sequence: sequence, events: bytes))
+                }
+                let session = JournalSession(uuid: entry.uuid, libraryIdentity: entry.libraryIdentity, startedAt: entry.startedAt,
+                    endedAt: entry.endedAt, incomplete: entry.incomplete, acknowledgedThrough: entry.acknowledgedThrough, chunks: chunks)
+                guard !session.libraryIdentity.isEmpty, session.libraryIdentity.utf8.count <= 256,
+                      session.startedAt.timeIntervalSince1970.isFinite,
+                      session.endedAt.map({ $0.timeIntervalSince1970.isFinite && $0 >= session.startedAt }) ?? true,
+                      session.acknowledgedThrough >= -1, session.acknowledgedThrough < chunks.count,
+                      !session.incomplete || session.endedAt != nil else { throw SessionJournalError.invalidState }
+                var previousTime = -Double.infinity
+                for chunk in chunks {
+                    let bounds = try Self.validateEvents(chunk.events)
+                    guard bounds.first >= previousTime else { throw SessionJournalError.invalidEvents }
+                    previousTime = bounds.last
+                }
+                saved.append(session)
+                } catch {
+                    // Preserve original manifest entry and every recoverable byte.
+                    // Never export a silently truncated session as complete.
+                    quarantined.append(entry); damagedSessionIDs.append(entry.uuid)
+                }
+            }
+            guard Set(stored.sessions.map(\.uuid)).count == stored.sessions.count else { throw SessionJournalError.invalidState }
+            // The exact last persisted event is the only supported recovery boundary.
+            // No new mapper may leave a crashed/uncertain prior session open.
+            var recovered = false
+            for i in saved.indices where saved[i].endedAt == nil && usage.bytes < Self.maximumDiskBytes && usage.files < Self.maximumFiles {
+                let last = try Self.validateEvents(saved[i].chunks.last!.events).last
+                let end = saved[i].startedAt.addingTimeInterval(last)
+                guard end.timeIntervalSince1970.isFinite else { throw SessionJournalError.invalidState }
+                saved[i].endedAt = end
+                saved[i].incomplete = true
+                recovered = true
+            }
+            if recovered, usage.bytes < Self.maximumDiskBytes, usage.files < Self.maximumFiles {
+                do { try writer(Self.encodeManifest(saved, preserving: quarantined), file) }
+                catch { throw SessionJournalError.persistence }
+            }
+            sessions = saved
+            eventByteCount = saved.reduce(0) { $0 + $1.chunks.reduce(0) { $0 + $1.events.count } }
+        } else { sessions = [] }
+    }
+
+    public func all() -> [JournalSession] { sessions }
+    public var isReadOnly: Bool { storageBlocked || uncertainWrite }
+
+    /// Local recovery evidence only, not authorization to share or delete it.
+    /// Manifest descriptor preserves identity and committed chunk count. Each
+    /// safely readable original chunk is returned independently, without filling
+    /// a missing/corrupt suffix with invented events.
+    public func damagedEvidence(uuid: UUID) throws -> (descriptor: Data, readableChunks: [SessionEventChunk]) {
+        guard let entry = quarantined.first(where: { $0.uuid == uuid }) else { throw SessionJournalError.invalidState }
+        var chunks: [SessionEventChunk] = []
+        for sequence in 0..<min(entry.chunkCount, Self.maximumFiles) {
+            let source = Self.chunkURL(file, uuid, sequence)
+            guard let properties = try? source.resourceValues(forKeys: [.isSymbolicLinkKey, .fileSizeKey]),
+                  properties.isSymbolicLink != true, let size = properties.fileSize, size <= 160 * 1024,
+                  let bytes = try? Data(contentsOf: source) else { continue }
+            chunks.append(.init(sequence: sequence, events: bytes))
+        }
+        return (try JSONEncoder().encode(entry), chunks)
+    }
+
+    public func open(uuid: UUID, libraryIdentity: String, startedAt: Date, context: Data) throws {
+        guard startedAt.timeIntervalSince1970.isFinite, sessions.count < 512, !libraryIdentity.isEmpty, libraryIdentity.utf8.count <= 256,
+              !sessions.contains(where: { $0.uuid == uuid }), !quarantined.contains(where: { $0.uuid == uuid }) else { throw SessionJournalError.invalidState }
+        try Self.validateEvents(context)
+        let value = JournalSession(uuid: uuid, libraryIdentity: libraryIdentity, startedAt: startedAt,
+            incomplete: false, acknowledgedThrough: -1, chunks: [.init(sequence: 0, events: context)])
+        try replace(sessions + [value])
+    }
+
+    public func append(uuid: UUID, expectedSequence: Int, events: Data) throws {
+        guard let i = sessions.firstIndex(where: { $0.uuid == uuid }) else { throw SessionJournalError.invalidState }
+        guard !storageBlocked else { throw SessionJournalError.full }
+        guard sessions[i].endedAt == nil else { throw SessionJournalError.sessionClosed }
+        guard expectedSequence == sessions[i].chunks.count else { throw SessionJournalError.sequenceMismatch }
+        try Self.validateEvents(events)
+        if let previous = sessions[i].chunks.last {
+            let old = try JSONSerialization.jsonObject(with: previous.events) as! [[String: Any]]
+            let new = try JSONSerialization.jsonObject(with: events) as! [[String: Any]]
+            guard (new.first!["t"] as! NSNumber).doubleValue >= (old.last!["t"] as! NSNumber).doubleValue else {
+                throw SessionJournalError.invalidEvents
+            }
+        }
+        var next = sessions
+        next[i].chunks.append(.init(sequence: expectedSequence, events: events))
+        try replace(next)
+    }
+
+    public func close(uuid: UUID, endedAt: Date, incomplete: Bool = false) throws {
+        guard endedAt.timeIntervalSince1970.isFinite, let i = sessions.firstIndex(where: { $0.uuid == uuid }), endedAt >= sessions[i].startedAt else { throw SessionJournalError.invalidState }
+        if let previous = sessions[i].endedAt {
+            guard previous == endedAt, sessions[i].incomplete == incomplete else { throw SessionJournalError.sessionClosed }
+            return
+        }
+        var next = sessions; next[i].endedAt = endedAt; next[i].incomplete = incomplete
+        try replace(next)
+    }
+
+    /// Only a transport with a verified exact durable receipt should call this.
+    /// Out-of-order or future receipts cannot skip uncommitted local evidence.
+    public func acknowledge(uuid: UUID, libraryIdentity: String, sequence: Int, exactEvents: Data) throws {
+        guard let i = sessions.firstIndex(where: { $0.uuid == uuid }), sessions[i].libraryIdentity == libraryIdentity,
+              sequence >= 0, sequence < sessions[i].chunks.count,
+              sessions[i].chunks[sequence].events == exactEvents,
+              sequence <= sessions[i].acknowledgedThrough + 1 else { throw SessionJournalError.sequenceMismatch }
+        if sequence <= sessions[i].acknowledgedThrough { return }
+        var next = sessions; next[i].acknowledgedThrough = sequence; try replace(next)
+    }
+
+    private func replace(_ next: [JournalSession]) throws {
+        guard !uncertainWrite else { throw SessionJournalError.persistence }
+        // A sole actor owns this tree. Startup reconciles all retained/orphan
+        // entries; subsequent writes update only touched paths, never rescan
+        // historical chunks. External writes require closing and reopening.
+        guard !storageBlocked, storageBytes < Self.maximumDiskBytes - 512 * 1024,
+              storageFiles < Self.maximumFiles - 4 else { storageBlocked = true; throw SessionJournalError.full }
+        let data = try Self.encodeManifest(next, preserving: quarantined)
+        var addedBytes = 0
+        var touched: Set<URL> = [file, file.appendingPathExtension("chunks")]
+        for session in next {
+            let previous = sessions.first { $0.uuid == session.uuid }
+            for chunk in session.chunks.dropFirst(previous?.chunks.count ?? 0) {
+                addedBytes += chunk.events.count
+                let target = Self.chunkURL(file, session.uuid, chunk.sequence)
+                touched.insert(target); touched.insert(target.deletingLastPathComponent())
+            }
+        }
+        guard data.count + eventByteCount + addedBytes <= Self.maximumBytes else { throw SessionJournalError.full }
+        let before = try Self.pathUsage(touched)
+        do {
+            for session in next {
+                let previous = sessions.first { $0.uuid == session.uuid }
+                for chunk in session.chunks.dropFirst(previous?.chunks.count ?? 0) {
+                    // Immutable bytes first. A crash before manifest publication
+                    // leaves an unreferenced orphan, never an advanced prefix.
+                    let destination = Self.chunkURL(file, session.uuid, chunk.sequence)
+                    if FileManager.default.fileExists(atPath: destination.path) {
+                        guard try Data(contentsOf: destination) == chunk.events else { throw SessionJournalError.persistence }
+                    } else { try writer(chunk.events, destination) }
+                }
+            }
+            try writer(data, file)
+        } catch {
+            // Rename may have landed before directory flush failed. Force a
+            // reopen/reconciliation instead of overwriting uncertain disk state.
+            uncertainWrite = true
+            throw SessionJournalError.persistence
+        }
+        sessions = next
+        eventByteCount += addedBytes
+        let after: (bytes: Int, files: Int)
+        do { after = try Self.pathUsage(touched) }
+        catch { uncertainWrite = true; throw SessionJournalError.persistence }
+        storageBytes += after.bytes - before.bytes
+        storageFiles += after.files - before.files
+        storageBlocked = storageBytes >= Self.maximumDiskBytes || storageFiles >= Self.maximumFiles
+    }
+
+    private static func chunkURL(_ file: URL, _ id: UUID, _ sequence: Int) -> URL {
+        file.appendingPathExtension("chunks").appendingPathComponent(id.uuidString)
+            .appendingPathComponent(String(sequence) + ".json")
+    }
+
+    private static func encodeManifest(_ sessions: [JournalSession], preserving damaged: [StoredSession] = []) throws -> Data {
+        try JSONEncoder().encode(Envelope(version: 2, sessions: sessions.map {
+            StoredSession(uuid: $0.uuid, libraryIdentity: $0.libraryIdentity, startedAt: $0.startedAt,
+                endedAt: $0.endedAt, incomplete: $0.incomplete, acknowledgedThrough: $0.acknowledgedThrough,
+                chunkCount: $0.chunks.count)
+        } + damaged))
+    }
+
+    private static func pathUsage(_ paths: Set<URL>) throws -> (bytes: Int, files: Int) {
+        var bytes = 0, files = 0
+        for path in paths where FileManager.default.fileExists(atPath: path.path) {
+            let value = try path.resourceValues(forKeys: [.isSymbolicLinkKey, .fileAllocatedSizeKey, .fileSizeKey])
+            guard value.isSymbolicLink != true else { throw SessionJournalError.invalidState }
+            bytes += max(value.fileAllocatedSize ?? 0, value.fileSize ?? 0); files += 1
+        }
+        return (bytes, files)
+    }
+
+    private static func diskUsage(_ file: URL) throws -> (bytes: Int, files: Int) {
+        var bytes = 0, files = 0
+        let root = file.appendingPathExtension("chunks")
+        if FileManager.default.fileExists(atPath: file.path) {
+            let value = try file.resourceValues(forKeys: [.fileAllocatedSizeKey, .fileSizeKey])
+            bytes += max(value.fileAllocatedSize ?? 0, value.fileSize ?? 0); files += 1
+        }
+        if FileManager.default.fileExists(atPath: root.path) {
+            let rootUsage = try pathUsage([root])
+            bytes += rootUsage.bytes; files += rootUsage.files
+            guard let iterator = FileManager.default.enumerator(at: root,
+                includingPropertiesForKeys: [.isRegularFileKey, .isSymbolicLinkKey, .fileAllocatedSizeKey, .fileSizeKey]) else { throw SessionJournalError.persistence }
+            for case let child as URL in iterator {
+                let value = try child.resourceValues(forKeys: [.isRegularFileKey, .isSymbolicLinkKey, .fileAllocatedSizeKey, .fileSizeKey])
+                if value.isSymbolicLink == true {
+                    // Do not follow external content or hide healthy evidence.
+                    // Preserve the entry and freeze writes for host repair.
+                    return (maximumDiskBytes, max(files + 1, 1))
+                }
+                files += 1
+                bytes += max(value.fileAllocatedSize ?? 0, value.fileSize ?? 0)
+                // Bounded enumeration. Saturation blocks writes, preserves reads.
+                if files >= maximumFiles || bytes >= maximumDiskBytes { break }
+            }
+        }
+        return (bytes, files)
+    }
+
+    @discardableResult private static func validateEvents(_ data: Data) throws -> (first: Double, last: Double) {
+        guard data.count <= 160 * 1024,
+              let events = try JSONSerialization.jsonObject(with: data) as? [[String: Any]],
+              !events.isEmpty, events.count <= 1024 else { throw SessionJournalError.invalidEvents }
+        var previous = -Double.infinity
+        for event in events {
+            guard let time = event["t"] as? NSNumber, CFGetTypeID(time) != CFBooleanGetTypeID(),
+                  time.doubleValue.isFinite, time.doubleValue >= 0, time.doubleValue >= previous,
+                  event["kind"] is String else { throw SessionJournalError.invalidEvents }
+            previous = time.doubleValue
+        }
+        return ((events.first!["t"] as! NSNumber).doubleValue, previous)
+    }
+
+    /// New bytes are flushed before rename; parent directory is flushed after it.
+    /// Atomic replacement is intended to retain old or complete new JSON. Power-loss
+    /// durability on Apple filesystems is not qualified by Linux tests.
+    public static func durableWrite(_ data: Data, _ file: URL) throws {
+        let parent = file.deletingLastPathComponent()
+        try FileManager.default.createDirectory(at: parent, withIntermediateDirectories: true)
+        let temporary = parent.appendingPathComponent(".session-journal-" + UUID().uuidString)
+        defer { try? FileManager.default.removeItem(at: temporary) }
+        guard FileManager.default.createFile(atPath: temporary.path, contents: nil,
+              attributes: [.posixPermissions: 0o600]) else { throw SessionJournalError.persistence }
+        let handle = try FileHandle(forWritingTo: temporary)
+        do { try handle.write(contentsOf: data); try handle.synchronize(); try handle.close() }
+        catch { try? handle.close(); throw error }
+        guard rename(temporary.path, file.path) == 0 else { throw SessionJournalError.persistence }
+        let directory = parent.path.withCString { systemOpen($0) }
+        guard directory >= 0 else { throw SessionJournalError.persistence }
+        defer { _ = systemClose(directory) }
+        guard fsync(directory) == 0 else { throw SessionJournalError.persistence }
+    }
+}
+
+private func systemOpen(_ path: UnsafePointer<CChar>) -> Int32 {
+    #if canImport(Darwin)
+    Darwin.open(path, O_RDONLY)
+    #else
+    Glibc.open(path, O_RDONLY | O_DIRECTORY)
+    #endif
+}
+private func systemClose(_ fd: Int32) -> Int32 {
+    #if canImport(Darwin)
+    Darwin.close(fd)
+    #else
+    Glibc.close(fd)
+    #endif
+}
diff --git a/ios/Packages/ManadjCore/Tests/ManadjCoreTests/AppliedSessionRecorderTests.swift b/ios/Packages/ManadjCore/Tests/ManadjCoreTests/AppliedSessionRecorderTests.swift
new file mode 100644
index 00000000..bf3b1375
--- /dev/null
+++ b/ios/Packages/ManadjCore/Tests/ManadjCoreTests/AppliedSessionRecorderTests.swift
@@ -0,0 +1,64 @@
+import XCTest
+@testable import ManadjCore
+
+final class AppliedSessionRecorderTests: XCTestCase {
+    func segment(_ start: UInt64, _ end: UInt64, playing: Bool, fader: Double = 1) -> AppliedSessionSegment {
+        var deck = AppliedSessionDeck()
+        deck.load = 7; deck.trackID = 42; deck.ready = true; deck.playing = playing; deck.fader = fader
+        deck.startPosition = Double(start) / 48000; deck.position = Double(end) / 48000
+        return .init(startFrame: start, endFrame: end, sampleRate: 48000, crossfade: 0,
+                     decks: [deck, .init(), .init(), .init()])
+    }
+    func testSilentContextOpensOnlyWhenAudibleAndKeepsSegmentControlTime() throws {
+        var recorder = AppliedSessionRecorder()
+        let date = Date()
+        XCTAssertTrue(try recorder.observe(segment(0, 96, playing: false), wallTime: date).isEmpty)
+        let open = try recorder.observe(segment(96, 192, playing: true), wallTime: date)
+        guard case .open(_, _, let data) = open.first else { return XCTFail() }
+        let events = try JSONSerialization.jsonObject(with: data) as! [[String: Any]]
+        let play = events.first { $0["action"] as? String == "play" }!
+        XCTAssertEqual(play["t"] as! Double, 96.0 / 48000)
+        XCTAssertEqual(play["playhead"] as! Double, 96.0 / 48000)
+        let changed = try recorder.observe(segment(192, 288, playing: true, fader: 0.25), wallTime: date)
+        guard case .append(_, 1, let changes) = changed.first else { return XCTFail() }
+        let rows = try JSONSerialization.jsonObject(with: changes) as! [[String: Any]]
+        XCTAssertTrue(rows.contains { $0["control"] as? String == "fader" && $0["t"] as? Double == 192.0 / 48000 })
+        XCTAssertEqual(recorder.stop(at: date.addingTimeInterval(1), incomplete: true).count, 1)
+    }
+    func testGapUnresolvedAndCueOnlyNeverBecomeCompleteSession() throws {
+        var recorder = AppliedSessionRecorder()
