+        }.padding(8).overlay(Rectangle().stroke(Ink.edge))
+        .fileImporter(isPresented: $choosing, allowedContentTypes: [.json]) { result in
+            if case .success(let url) = result { importConfiguration(url) }
+        }
+    }
+}
