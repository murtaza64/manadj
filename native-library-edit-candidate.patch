+    private var editJournal: LibraryEditJournal?
+    private var editBindings: [Int: UUID] = [:]
+    private var editMutation = false
+
+    /// Disabled candidate: caller must supply verified logical bindings. Local
+    /// desktop IDs alone are never converted into cross-device identity.
+    public func prepareEdits(libraryIdentity: String, bindings: [Int: UUID]) throws {
+        guard editJournal == nil, !syncing, bindings.keys.allSatisfy({ $0 > 0 }),
+              Set(bindings.values).count == bindings.count else { throw LibraryEditJournalError.invalid }
+        editJournal = try LibraryEditJournal(file: store.root.appendingPathComponent("continuous-edits.json"), libraryIdentity: libraryIdentity)
+        editBindings = bindings
+    }
+
+    public func editTrack(_ localID: Int, to value: LibraryEditValue, parents: [UUID]) async throws {
+        guard !syncing, !editMutation, let journal = editJournal, let logical = editBindings[localID],
+              let track = snapshot?.tracks.first(where: { $0.id == localID }) else { throw LibraryEditJournalError.invalid }
+        editMutation = true
+        defer { editMutation = false }
+        let base: LibraryEditValue = value.field == "title" ? .title(track.title) : .mainCue(track.mainCue)
+        let previous = await journal.project(logicalTrackID: logical, base: base)
+        _ = try await journal.append(logicalTrackID: logical, oldValue: previous.value, newValue: value, parents: parents)
+    }
+
+    public func pendingEdits() async -> [LibraryEditIntent] { await editJournal?.pending() ?? [] }
+
+    private func projectedSnapshot() async -> Snapshot? {
+        guard var result = snapshot, let journal = editJournal else { return snapshot }
+        // Capture bindings before await. prepareEdits is one-shot and snapshots
+        // are value types, so reentrancy cannot mix libraries or overwrite disk.
+        let bindings = editBindings
+        let intents = await journal.pending()
+        for index in result.tracks.indices {
+            guard let logical = bindings[result.tracks[index].id] else { continue }
+            let title = LibraryEditJournal.project(intents, logicalTrackID: logical, base: .title(result.tracks[index].title))
+            let cue = LibraryEditJournal.project(intents, logicalTrackID: logical, base: .mainCue(result.tracks[index].mainCue))
+            if case .title(let value) = title.value { result.tracks[index].title = value }
+            if case .mainCue(let value) = cue.value { result.tracks[index].mainCue = value }
+        }
+        return result
+    }
+
+    public func editConflicts() async -> [UUID: [LibraryEditProjection]] {
+        guard let snapshot, let journal = editJournal else { return [:] }
+        var result: [UUID: [LibraryEditProjection]] = [:]
+        let intents = await journal.pending()
+        for track in snapshot.tracks {
+            guard let logical = editBindings[track.id] else { continue }
+            for base in [LibraryEditValue.title(track.title), .mainCue(track.mainCue)] {
+                let projection = LibraryEditJournal.project(intents, logicalTrackID: logical, base: base)
+                if projection.conflictingBase != nil { result[logical, default: []].append(projection) }
+            }
+        }
+        return result
+    }
     public init(root: URL) throws {
         store = try LibraryStore(root: root)
         do {
@@ -30,9 +84,9 @@ public actor LibraryRepository {
